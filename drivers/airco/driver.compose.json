{
  "name": {
    "en": "Airconditioning",
    "nl": "Airconditioning"
  },
  "class": "thermostat",
  "capabilities": [
    "onoff",
    "thermostat_mode",
    "target_temperature",
    "thermostat_fan_speed",
    "airco_swing",
    "airco_louver",
    "measure_temperature",
    "measure_temperature.outside",
    "thermostat_boost",
    "thermostat_eco",
    "thermostat_freeze_protection",
    "ieco",
    "ion_mode",
    "jet_cool",
    "out_silent",
    "follow_me"
  ],
  "capabilitiesOptions": {
    "target_temperature": {
      "min": 16,
      "max": 30,
      "step": 1
    },
    "measure_temperature": {
      "title": {
        "en": "Inside temperature",
        "de": "Innentemperatur",
        "nl": "Binnentemperatuur"
      }
    },
    "measure_temperature.outside": {
      "title": {
        "en": "Outside temperature",
        "de": "Außentemperatur",
        "nl": "Buitentemperatuur"
      }
    },
    "measure_power": {
      "title": {
        "en": "Power consumption",
        "de": "Stromverbrauch",
        "nl": "Stroomverbruik"
      }
    },
    "meter_power": {
      "title": {
        "en": "Energy total",
        "de": "Energie gesamt",
        "nl": "Energie totaal"
      }
    },
    "measure_humidity": {
      "title": {
        "en": "Humidity",
        "de": "Luftfeuchte",
        "nl": "Vochtigheid"
      }
    }
  },
  "platforms": [
    "local"
  ],
  "connectivity": [
    "lan"
  ],
  "pair": [
    {
      "id": "list_devices",
      "template": "list_devices",
      "options": {
        "singular": true
      },
      "navigation": {
        "next": "token_and_key"
      }
    },
    {
      "id": "token_and_key",
      "navigation": {
        "next": "login_credentials"
      }
    },
    {
      "id": "login_credentials",
      "navigation": {
        "next": "add_devices"
      }
    },
    {
      "id": "add_devices",
      "template": "add_devices"
    }
  ],
  "repair": [
    {
      "id": "token_and_key",
      "navigation": {
        "next": "login_credentials"
      }
    },
    {
      "id": "login_credentials"
    }
  ],
  "images": {
    "small": "{{driverAssetsPath}}/images/driver-small.png",
    "large": "{{driverAssetsPath}}/images/driver-large.png",
    "xlarge": "{{driverAssetsPath}}/images/driver-xlarge.png"
  }
}